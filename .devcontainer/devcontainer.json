{
  "name": "QRYPTON development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/qrypton/ui/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade 'pip>=26.2' && python -m pip install -e '.[dev]' && npm --prefix web ci",
  "portsAttributes": {
    "3000": { "label": "QRYPTON dashboard", "onAutoForward": "notify" },
    "8000": { "label": "QRYPTON API", "onAutoForward": "notify" },
    "8501": { "label": "Optional Streamlit viewer", "onAutoForward": "notify" }
  },
  "forwardPorts": [
    3000, 8000, 8501
  ]
}
